{
    "name": "tradetracker-private",
    "version": "1.0.0",
    "description": "A Flask-based web application for tracking trading-card auctions, singles, bulk inventory, and sales. Includes invoice (PDF) generation, a companion Chrome extension integration for importing data from Cardmarket, and FIFO-based bulk/holo inventory accounting.",
    "keywords": [],
    "homepage": "https://github.com/FirstLight1/tradeTracker-private#readme",
    "bugs": {
        "url": "https://github.com/FirstLight1/tradeTracker-private/issues"
    },
    "license": "ISC",
    "author": "",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FirstLight1/tradeTracker-private.git"
    },
    "directories": {
        "doc": "docs",
        "test": "tests"
    },
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "lint": "oxlint tradeTracker/static/scripts",
        "lint:fix": "oxlint --fix tradeTracker/static/scripts",
        "format": "oxfmt tradeTracker/static/scripts",
        "format:check": "oxfmt --check tradeTracker/static/scripts"
    },
    "devDependencies": {
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0"
    }
}
